{
  "name": "dinotty-omp",
  "version": "1.0.0",
  "description": "Dinotty plugin for the Oh My Pi coding agent: live session HUD, managed tmux launcher, visual session explorer and skill palette",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "check:bridge": "node --check bin/omp-bridge",
    "link": "node scripts/link-plugin.mjs",
    "unlink": "node scripts/link-plugin.mjs --remove"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^5.2.11",
    "vue": "^3.4.27",
    "vue-tsc": "^2.2.0"
  },
  "license": "MIT",
  "author": "tickernelz",
  "homepage": "https://github.com/tickernelz/dinotty-omp",
  "repository": {
    "type": "git",
    "url": "https://github.com/tickernelz/dinotty-omp.git"
  },
  "bugs": {
    "url": "https://github.com/tickernelz/dinotty-omp/issues"
  },
  "keywords": [
    "dinotty",
    "dinotty-plugin",
    "omp",
    "oh-my-pi",
    "terminal",
    "tmux",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.0"
}

{
  "name": "@tickernelz/dinotty-omp",
  "version": "1.1.2",
  "description": "Dinotty plugin for the Oh My Pi coding agent: live session HUD, managed tmux launcher, visual session explorer and skill palette",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "check:bridge": "node --check bin/omp-bridge && node --check scripts/cli.mjs",
    "link": "node scripts/cli.mjs link",
    "unlink": "node scripts/cli.mjs unlink"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vue": "^3.4.27",
    "vue-tsc": "^2.2.0"
  },
  "license": "MIT",
  "author": "tickernelz",
  "homepage": "https://github.com/tickernelz/dinotty-omp",
  "repository": {
    "type": "git",
    "url": "https://github.com/tickernelz/dinotty-omp.git"
  },
  "bugs": {
    "url": "https://github.com/tickernelz/dinotty-omp/issues"
  },
  "keywords": [
    "dinotty",
    "dinotty-plugin",
    "omp",
    "oh-my-pi",
    "terminal",
    "tmux",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.0",
  "bin": {
    "dinotty-omp": "scripts/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "scripts/cli.mjs",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

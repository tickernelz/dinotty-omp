#!/usr/bin/env node
import os from 'node:os';
import fs from 'node:fs';
import path from 'node:path';
import { execSync } from 'node:child_process';

const action = process.argv[2] || 'active';
const paneId = process.argv[3] || '';
const homeDir = os.homedir();
const isWin = os.platform() === 'win32';

function safeExec(cmd) {
  try {
    return execSync(cmd, { encoding: 'utf8', stdio: ['pipe', 'pipe', 'ignore'], timeout: 1500 }).trim();
  } catch {
    return '';
  }
}

function resolveByPane(targetPane) {
  let targetCwd = '';
  let sessionFile = '';
  let isRunning = false;

  if (targetPane) {
    const ledgerPath = path.join(homeDir, '.config', 'dinotty', 'session-ledger.json');
    if (fs.existsSync(ledgerPath)) {
      try {
        const ledger = JSON.parse(fs.readFileSync(ledgerPath, 'utf8'));
        const entry = ledger.entries?.find((e) => e.pane_id === targetPane);
        if (entry && entry.pid) {
          const pid = entry.pid;
          if (!isWin) {
            const tty = safeExec(`ps -o tty= -p ${pid}`).trim();
            if (tty) {
              const clientsOut = safeExec(`tmux list-clients -F '#{client_tty} #{client_session}'`);
              for (const line of clientsOut.split('\n')) {
                const parts = line.trim().split(/\s+/);
                if (parts[0] === `/dev/${tty}` && parts[1]) {
                  const sName = parts[1];
                  const pInfo = safeExec(`tmux list-panes -t "${sName}" -F '#{pane_current_command}|#{pane_current_path}'`).split('\n')[0] || '';
                  const [cmd, pPath] = pInfo.split('|');
                  targetCwd = pPath || '';
                  if (cmd === 'omp' || safeExec(`pgrep -f "omp.*--config" || pgrep -x omp`).length > 0) {
                    const ompPid = safeExec(`tmux list-panes -t "${sName}" -F '#{pane_pid}'`);
                    if (ompPid) {
                      const childOmp = safeExec(`pgrep -P "${ompPid}" -f omp || true`).trim();
                      if (childOmp || cmd === 'omp') {
                        isRunning = true;
                      }
                    }
                  }
                  break;
                }
              }
            }
            if (!targetCwd && fs.existsSync(`/proc/${pid}/cwd`)) {
              try {
                targetCwd = fs.realpathSync(`/proc/${pid}/cwd`);
                const childOmp = safeExec(`pgrep -P "${pid}" -f omp || true`).trim();
                if (childOmp) isRunning = true;
              } catch {}
            }
          }
        }
      } catch {}
    }
  }

  if (!isWin) {
    safeExec("tmux set-option -g set-titles on 2>/dev/null && tmux set-option -g set-titles-string '#T' 2>/dev/null || true");
  }

  if (targetCwd && isRunning) {
    let rel = path.relative(homeDir, targetCwd);
    let slug = '-';
    if (rel && !rel.startsWith('..')) {
      slug = '-' + rel.split(path.sep).filter(Boolean).join('-');
    } else {
      slug = '-' + targetCwd.split(path.sep).filter(Boolean).join('-');
    }

    const wsDir = path.join(homeDir, '.omp', 'agent', 'sessions', slug);
    if (fs.existsSync(wsDir)) {
      try {
        const files = fs.readdirSync(wsDir)
          .filter((f) => f.endsWith('.jsonl') && !f.startsWith('__'))
          .map((f) => {
            const fp = path.join(wsDir, f);
            return { path: fp, mtime: fs.statSync(fp).mtimeMs };
          })
          .sort((a, b) => b.mtime - a.mtime);
        if (files.length > 0) {
          sessionFile = files[0].path;
        }
      } catch {}
    }
  }

  const result = {
    cwd: targetCwd || homeDir,
    sessionFile: sessionFile || '',
    isRunning: isRunning
  };
  process.stdout.write(JSON.stringify(result) + '\n');
}

if (action === 'pane' || action === 'active') {
  resolveByPane(paneId);
  process.exit(0);
}

if (action === 'tmux-panes') {
  if (isWin) {
    process.stdout.write('[]\n');
    process.exit(0);
  }
  const out = safeExec("tmux list-panes -a -F '{\"session\":\"#{session_name}\",\"active\":\"#{pane_active}\",\"path\":\"#{pane_current_path}\",\"cmd\":\"#{pane_current_command}\"}'");
  const parsed = out.split('\n').filter(Boolean).map((l) => {
    try { return JSON.parse(l); } catch { return null; }
  }).filter(Boolean);
  process.stdout.write(JSON.stringify(parsed) + '\n');
  process.exit(0);
}

process.stdout.write(JSON.stringify({ error: 'unknown action' }) + '\n');
process.exit(1);

#!/usr/bin/env node
import os from 'node:os';
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';

const PLATFORM = os.platform();
const IS_WINDOWS = PLATFORM === 'win32';
const IS_MACOS = PLATFORM === 'darwin';
const HOME = os.homedir();
const SESSION_FILE_PATTERN = /^\d{4}-\d{2}-\d{2}T[\dTZ:.\-]*_[0-9a-f-]+\.jsonl$/i;
const METRIC_CACHE_DIR = path.join(os.tmpdir(), 'dinotty-omp-metrics');
const METRIC_CACHE_LIMIT = 24;
const WINDOWS_FRESHNESS_MS = 90_000;

function ompHome() {
  return process.env.PI_CODING_AGENT_DIR || path.join(HOME, '.omp', 'agent');
}

function ompRunHome() {
  return path.join(HOME, '.omp', 'run', 'daemons');
}

function ompCli() {
  const names = IS_WINDOWS ? ['omp.exe', 'omp.cmd'] : ['omp'];
  const candidates = [];
  if (process.env.OMP_BIN) candidates.push(process.env.OMP_BIN);
  if (IS_WINDOWS) {
    candidates.push(path.join(HOME, 'AppData', 'Roaming', 'npm', 'omp.cmd'));
  } else {
    candidates.push(path.join(HOME, '.bun', 'bin', 'omp'));
    candidates.push(path.join(HOME, '.local', 'bin', 'omp'));
  }
  for (const name of names) candidates.push(name);
  for (const candidate of candidates) {
    if (!path.isAbsolute(candidate) || fs.existsSync(candidate)) return candidate;
  }
  return '';
}
function run(file, args, timeout = 2000) {
  try {
    return execFileSync(file, args, {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
      timeout,
      windowsHide: true
    }).trim();
  } catch {
    return '';
  }
}

const jsonCache = new Map();

function readJson(filePath) {
  if (jsonCache.has(filePath)) return jsonCache.get(filePath);
  let value = null;
  try {
    value = JSON.parse(fs.readFileSync(filePath, 'utf8'));
  } catch {
    value = null;
  }
  jsonCache.set(filePath, value);
  return value;
}

function ledgerEntryFor(paneId) {
  const ledger = readJson(path.join(HOME, '.config', 'dinotty', 'session-ledger.json'));
  const entries = ledger?.entries;
  if (!Array.isArray(entries)) return null;
  for (const item of entries) {
    if (item && item.pane_id === paneId) return item;
  }
  return null;
}

function isAlive(pid) {
  if (!Number.isInteger(pid) || pid <= 0) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch (err) {
    return err && err.code === 'EPERM';
  }
}

function normalizeDir(input) {
  if (!input) return '';
  let value = String(input).trim();
  if (!value) return '';
  if (value.startsWith('~')) value = path.join(HOME, value.slice(1));
  value = path.resolve(value);
  if (value.length > 1 && (value.endsWith('/') || value.endsWith('\\'))) {
    value = value.slice(0, -1);
  }
  return IS_WINDOWS ? value.toLowerCase() : value;
}

function encodeWorkspaceSlug(cwd) {
  if (!cwd) return '-';
  const normalized = String(cwd).replace(/\\/g, '/').replace(/\/+$/, '');
  const homePrefix = HOME.replace(/\\/g, '/').replace(/\/+$/, '');
  let relative = normalized.startsWith(homePrefix)
    ? normalized.slice(homePrefix.length)
    : normalized;
  relative = relative.replace(/^\/+/, '');
  if (!relative) return '-';
  return '-' + relative.replace(/[^a-zA-Z0-9_-]+/g, '-');
}

function listProcesses() {
  if (IS_WINDOWS) return [];
  const raw = run('ps', ['-eo', 'pid=,ppid=,comm=']);
  if (!raw) return [];
  const rows = [];
  for (const line of raw.split('\n')) {
    const match = line.trim().match(/^(\d+)\s+(\d+)\s+(.*)$/);
    if (match) {
      rows.push({ pid: Number(match[1]), ppid: Number(match[2]), comm: match[3].trim() });
    }
  }
  return rows;
}

function descendantsOf(rootPid, table) {
  const children = new Map();
  for (const row of table) {
    if (!children.has(row.ppid)) children.set(row.ppid, []);
    children.get(row.ppid).push(row);
  }
  const found = [];
  const queue = [rootPid];
  const seen = new Set(queue);
  while (queue.length) {
    const current = queue.shift();
    for (const child of children.get(current) || []) {
      if (seen.has(child.pid)) continue;
      seen.add(child.pid);
      found.push(child);
      queue.push(child.pid);
    }
  }
  return found;
}

let tmuxProbe = null;

function tmuxAvailable() {
  if (tmuxProbe === null) tmuxProbe = Boolean(run('tmux', ['-V'], 1000));
  return tmuxProbe;
}

const ttyCache = new Map();

function ttyOf(pid) {
  const key = String(pid);
  if (ttyCache.has(key)) return ttyCache.get(key);
  const tty = run('ps', ['-o', 'tty=', '-p', key]).trim();
  const value = tty && tty !== '?' ? tty : '';
  ttyCache.set(key, value);
  return value;
}

function clientTargetForTty(tty) {
  if (!tty || !tmuxAvailable()) return '';
  const clients = run('tmux', ['list-clients', '-F', '#{client_tty}\t#{client_session}']);
  for (const line of clients.split('\n')) {
    const [clientTty, sessionName] = line.split('\t');
    if (!clientTty || !sessionName) continue;
    const trimmed = clientTty.trim();
    if (trimmed !== `/dev/${tty}` && trimmed !== tty) continue;
    return trimmed;
  }
  return '';
}

function tmuxField(target, field) {
  if (!target || !tmuxAvailable()) return '';
  const value = run('tmux', ['display-message', '-p', '-t', target, '-F', field]);
  return value.split('\n')[0].trim();
}

function resolveWorkspaceFromPane(paneId, cwdHint) {
  const fallback = normalizeDir(cwdHint);
  if (IS_WINDOWS || !paneId) return fallback;

  const entry = ledgerEntryFor(paneId);
  if (!entry?.pid) return fallback;

  const shellPid = entry.pid;
  const clientTty = clientTargetForTty(ttyOf(shellPid));
  const panePath = tmuxField(clientTty, '#{pane_current_path}');
  if (panePath) {
    const resolved = normalizeDir(panePath);
    if (resolved) return resolved;
  }

  try {
    const direct = fs.realpathSync(`/proc/${shellPid}/cwd`);
    if (direct) return normalizeDir(direct);
  } catch {}

  return fallback;
}

function pidsForPane(paneId) {
  if (IS_WINDOWS || !paneId) return [];

  const entry = ledgerEntryFor(paneId);
  if (!entry?.pid) return [];

  const shellPid = entry.pid;
  const procTable = listProcesses();
  const candidatePids = [shellPid, ...descendantsOf(shellPid, procTable).map((p) => p.pid)];

  const clientTty = clientTargetForTty(ttyOf(shellPid));
  if (clientTty) {
    const panePids = run('tmux', ['list-panes', '-t', clientTty, '-F', '#{pane_pid}'])
      .split('\n')
      .filter(Boolean)
      .map(Number);
    for (const ppid of panePids) {
      if (!candidatePids.includes(ppid)) candidatePids.push(ppid);
      for (const child of descendantsOf(ppid, procTable)) {
        if (!candidatePids.includes(child.pid)) candidatePids.push(child.pid);
      }
    }
  }

  return candidatePids;
}

function liveOmpClients() {
  const root = ompRunHome();
  if (!fs.existsSync(root)) return [];
  const clients = [];
  let daemons = [];
  try {
    daemons = fs.readdirSync(root);
  } catch {
    return [];
  }
  for (const daemon of daemons) {
    const clientDir = path.join(root, daemon, 'clients');
    if (!fs.existsSync(clientDir)) continue;
    let files = [];
    try {
      files = fs.readdirSync(clientDir);
    } catch {
      continue;
    }
    for (const file of files) {
      if (!file.endsWith('.json')) continue;
      const record = readJson(path.join(clientDir, file));
      if (!record || !record.projectDir || !isAlive(record.pid)) continue;
      clients.push({ pid: record.pid, projectDir: normalizeDir(record.projectDir) });
    }
  }
  return clients;
}

function openSessionFilesFor(pid) {
  const candidates = [];
  if (IS_WINDOWS) return candidates;

  if (IS_MACOS) {
    const raw = run('lsof', ['-p', String(pid), '-Fn'], 3000);
    for (const line of raw.split('\n')) {
      if (line.startsWith('n') && line.endsWith('.jsonl')) candidates.push(line.slice(1));
    }
    return candidates;
  }

  const fdDir = `/proc/${pid}/fd`;
  let handles = [];
  try {
    handles = fs.readdirSync(fdDir);
  } catch {
    return candidates;
  }
  for (const handle of handles) {
    try {
      const target = fs.readlinkSync(path.join(fdDir, handle));
      if (target.endsWith('.jsonl')) candidates.push(target);
    } catch {}
  }
  return candidates;
}

function newestTopLevelSession(workspaceDir) {
  const dir = path.join(ompHome(), 'sessions', encodeWorkspaceSlug(workspaceDir));
  if (!fs.existsSync(dir)) return null;
  let best = null;
  let entries = [];
  try {
    entries = fs.readdirSync(dir);
  } catch {
    return null;
  }
  for (const name of entries) {
    if (!SESSION_FILE_PATTERN.test(name)) continue;
    const full = path.join(dir, name);
    try {
      const stat = fs.statSync(full);
      if (!best || stat.mtimeMs > best.mtimeMs) best = { path: full, mtimeMs: stat.mtimeMs };
    } catch {}
  }
  return best;
}

function resolveSessionFile(workspaceDir, pids) {
  let best = null;
  for (const pid of pids) {
    for (const candidate of openSessionFilesFor(pid)) {
      if (!SESSION_FILE_PATTERN.test(path.basename(candidate))) continue;
      try {
        const stat = fs.statSync(candidate);
        if (!best || stat.mtimeMs > best.mtimeMs) best = { path: candidate, mtimeMs: stat.mtimeMs };
      } catch {}
    }
  }
  if (best) return best.path;

  if (!IS_WINDOWS) return '';

  const fallback = newestTopLevelSession(workspaceDir);
  if (!fallback) return '';
  if (Date.now() - fallback.mtimeMs > WINDOWS_FRESHNESS_MS) return '';
  return fallback.path;
}

function metricCachePath(sessionFile) {
  const digest = createHash('sha256').update(sessionFile).digest('hex');
  return path.join(METRIC_CACHE_DIR, `${digest}.json`);
}

function loadMetricCache(sessionFile) {
  try {
    const value = JSON.parse(fs.readFileSync(metricCachePath(sessionFile), 'utf8'));
    return value && typeof value === 'object' && !Array.isArray(value) ? value : null;
  } catch {
    return null;
  }
}

function saveMetricCache(sessionFile, state) {
  const cachePath = metricCachePath(sessionFile);
  const tmp = `${cachePath}.${process.pid}.${Date.now()}.tmp`;
  try {
    fs.mkdirSync(METRIC_CACHE_DIR, { recursive: true, mode: 0o700 });
    fs.writeFileSync(tmp, JSON.stringify(state), { mode: 0o600 });
    fs.renameSync(tmp, cachePath);
    const entries = fs.readdirSync(METRIC_CACHE_DIR)
      .map((name) => {
        const full = path.join(METRIC_CACHE_DIR, name);
        try {
          return { full, mtimeMs: fs.statSync(full).mtimeMs };
        } catch {
          return null;
        }
      })
      .filter(Boolean)
      .sort((a, b) => b.mtimeMs - a.mtimeMs);
    for (const entry of entries.slice(METRIC_CACHE_LIMIT)) {
      try {
        fs.unlinkSync(entry.full);
      } catch {}
    }
  } catch {
    try {
      fs.unlinkSync(tmp);
    } catch {}
  }
}

function emptyMetrics() {
  return {
    offset: 0,
    model: '',
    provider: '',
    thinkingLevel: '',
    totalTokens: 0,
    contextTokens: 0,
    totalCost: 0,
    status: 'idle',
    pending: [],
    turns: 0,
    updatedAt: 0
  };
}

function applyLine(state, line) {
  if (!line) return;
  let record;
  try {
    record = JSON.parse(line);
  } catch {
    return;
  }
  if (!record || typeof record !== 'object' || Array.isArray(record)) return;

  if (record.type === 'model_change') {
    if (record.model) state.model = String(record.model);
    if (record.provider) state.provider = String(record.provider);
    if (record.thinkingLevel) state.thinkingLevel = String(record.thinkingLevel);
    return;
  }

  if (record.type === 'thinking_level_change') {
    if (record.thinkingLevel) state.thinkingLevel = String(record.thinkingLevel);
    return;
  }

  if (record.type === 'custom') {
    if (record.customType === 'tool_execution_start') {
      const id = record.data?.toolCallId;
      if (id && !state.pending.includes(id)) state.pending.push(id);
      state.status = 'running_tool';
    } else if (record.customType === 'session_exit') {
      state.pending = [];
      state.status = 'idle';
    }
    return;
  }

  if (record.type !== 'message') return;

  const message = record.message || {};
  if (message.model) state.model = String(message.model);
  if (message.provider) state.provider = String(message.provider);

  const usage = message.usage;
  if (usage) {
    if (typeof usage.totalTokens === 'number') state.totalTokens = usage.totalTokens;
    if (typeof usage.cost?.total === 'number') state.totalCost += usage.cost.total;
  }
  const snapshotTokens = message.contextSnapshot?.promptTokens;
  if (typeof snapshotTokens === 'number') state.contextTokens = snapshotTokens;

  if (message.role === 'assistant') {
    state.turns += 1;
    let opened = false;
    if (Array.isArray(message.content)) {
      for (const part of message.content) {
        if (part?.type === 'toolCall' && part.id) {
          opened = true;
          if (!state.pending.includes(part.id)) state.pending.push(part.id);
        }
      }
    }
    state.status = opened || state.pending.length > 0 ? 'running_tool' : 'idle';
    return;
  }

  if (message.role === 'user') {
    state.status = 'thinking';
    return;
  }

  if (message.role === 'toolResult') {
    if (message.toolCallId) {
      state.pending = state.pending.filter((id) => id !== message.toolCallId);
    }
    if (message.isError) state.status = 'error';
    else if (state.pending.length === 0) state.status = 'thinking';
    return;
  }
}

function readMetrics(sessionFile) {
  let fd;
  try {
    fd = fs.openSync(sessionFile, 'r');
    const stat = fs.fstatSync(fd);
    if (!stat.isFile()) return null;
    const identity = `${stat.dev}:${stat.ino}:${stat.size}:${stat.mtimeMs}:${stat.ctimeMs}`;
    const cached = loadMetricCache(sessionFile);
    if (cached?.identity === identity) return finalizeMetrics(cached);
    const state = emptyMetrics();
    const buffer = Buffer.allocUnsafe(65536);
    let offset = 0;
    let parts = [];
    while (offset < stat.size) {
      const length = fs.readSync(fd, buffer, 0, Math.min(buffer.length, stat.size - offset), offset);
      if (!length) return null;
      offset += length;
      let start = 0;
      for (;;) {
        const end = buffer.indexOf(10, start);
        if (end < 0 || end >= length) break;
        const segment = buffer.subarray(start, end);
        const line = parts.length ? Buffer.concat([...parts, segment]).toString('utf8') : segment.toString('utf8');
        applyLine(state, line.trim());
        parts = [];
        start = end + 1;
      }
      if (start < length) parts.push(Buffer.from(buffer.subarray(start, length)));
    }
    if (parts.length) applyLine(state, Buffer.concat(parts).toString('utf8').trim());
    state.identity = identity;
    saveMetricCache(sessionFile, state);
    return finalizeMetrics(state);
  } catch {
    return null;
  } finally {
    if (fd !== undefined) fs.closeSync(fd);
  }
}

function finalizeMetrics(state) {
  return {
    model: state.model || 'unknown',
    provider: state.provider || 'unknown',
    thinkingLevel: state.thinkingLevel || 'auto',
    totalTokens: state.contextTokens || state.totalTokens || 0,
    totalCost: Number(state.totalCost.toFixed(6)),
    turns: state.turns || 0,
    status: state.pending.length > 0 ? 'running_tool' : state.status || 'idle'
  };
}

function describePane(paneId, cwdHint) {
  const workspace = resolveWorkspaceFromPane(paneId, cwdHint);
  const clients = liveOmpClients();
  const panePids = pidsForPane(paneId);

  let matching = [];
  if (panePids.length > 0) {
    const panePidSet = new Set(panePids);
    matching = clients.filter((client) => panePidSet.has(client.pid));
  } else if (!paneId || IS_WINDOWS) {
    matching = workspace ? clients.filter((client) => client.projectDir === workspace) : [];
  }

  if (matching.length === 0) {
    return { cwd: workspace, sessionFile: '', isRunning: false, state: 'inactive', summary: null };
  }

  const sessionFile = resolveSessionFile(workspace, matching.map((client) => client.pid));
  if (!sessionFile) {
    return { cwd: workspace, sessionFile: '', isRunning: true, state: 'starting', summary: null };
  }

  const summary = readMetrics(sessionFile);
  if (!summary) {
    return { cwd: workspace, sessionFile, isRunning: true, state: 'starting', summary: null };
  }

  return { cwd: workspace, sessionFile, isRunning: true, state: 'running', summary };
}

function listTmuxPanes() {
  if (IS_WINDOWS || !tmuxAvailable()) return [];
  const raw = run('tmux', [
    'list-panes',
    '-a',
    '-F',
    '#{session_name}\t#{pane_active}\t#{pane_current_path}\t#{pane_current_command}'
  ]);
  const panes = [];
  for (const line of raw.split('\n')) {
    const [session, active, cwd, command] = line.split('\t');
    if (!session) continue;
    panes.push({ session, active: active === '1', cwd: cwd || '', command: command || '' });
  }
  return panes;
}

function readSessionMeta(sessionFile) {
  let head = '';
  try {
    const fd = fs.openSync(sessionFile, 'r');
    try {
      const buf = Buffer.allocUnsafe(8192);
      const read = fs.readSync(fd, buf, 0, buf.length, 0);
      head = buf.subarray(0, read).toString('utf8');
    } finally {
      fs.closeSync(fd);
    }
  } catch {
    return { sessionId: '', cwd: '' };
  }

  for (const line of head.split('\n')) {
    const trimmed = line.trim();
    if (!trimmed) continue;
    let record;
    try {
      record = JSON.parse(trimmed);
    } catch {
      continue;
    }
    if (!record || typeof record !== 'object' || Array.isArray(record)) continue;
    if (record.type === 'session') {
      return { sessionId: record.id || '', cwd: record.cwd || '' };
    }
  }
  return { sessionId: '', cwd: '' };
}

function alignToLineStart(fd, offset) {
  const buffer = Buffer.allocUnsafe(65536);
  let end = offset;
  while (end > 0) {
    const start = Math.max(0, end - buffer.length);
    const length = fs.readSync(fd, buffer, 0, end - start, start);
    const index = buffer.subarray(0, length).lastIndexOf(10);
    if (index >= 0) return start + index + 1;
    end = start;
  }
  return 0;
}

function readChunk(sessionFile, requestedStart, maxBytes) {
  let fd;
  try {
    fd = fs.openSync(sessionFile, 'r');
    const stat = fs.fstatSync(fd);
    if (!stat.isFile()) return null;
    const size = stat.size;
    const requested = Number(requestedStart);
    const requestedOffset = Number.isFinite(requested) ? Math.floor(requested) : 0;
    const clampedOffset = Math.max(0, Math.min(requestedOffset, size));
    const start = clampedOffset >= size ? size : alignToLineStart(fd, clampedOffset);
    const limit = Number(maxBytes);
    const want = Math.min(Number.isFinite(limit) && limit > 0 ? Math.floor(limit) : 4096, 4 * 1024 * 1024);
    const target = Math.min(size, start + want);
    const parts = [];
    let end = start;
    let newlineEnd = -1;
    while (end < size) {
      const readLength = Math.min(65536, size - end, end < target ? target - end : size - end);
      const buffer = Buffer.allocUnsafe(readLength);
      const length = fs.readSync(fd, buffer, 0, readLength, end);
      if (!length) break;
      const bytes = buffer.subarray(0, length);
      parts.push(bytes);
      const newline = bytes.lastIndexOf(10);
      if (newline >= 0) newlineEnd = end - start + newline + 1;
      end += length;
      if (end >= target && newlineEnd >= 0) break;
    }

    if (newlineEnd < 0) newlineEnd = end - start;
    const content = Buffer.concat(parts).subarray(0, newlineEnd);
    const finalEnd = start + content.length;
    const meta = readSessionMeta(sessionFile);
    return {
      start,
      end: finalEnd,
      size,
      eof: finalEnd >= size,
      content: content.toString('utf8'),
      ...meta
    };
  } catch {
    return null;
  } finally {
    if (fd !== undefined) fs.closeSync(fd);
  }
}

function paneClientPids(paneId) {
  const candidates = new Set(pidsForPane(paneId));
  if (!candidates.size) return [];
  return liveOmpClients()
    .filter((client) => candidates.has(client.pid))
    .map((client) => client.pid)
    .sort((a, b) => a - b);
}

function listModelPresets() {
  const executable = ompCli();
  if (!executable) return null;
  const raw = run(executable, ['config', 'get', 'modelPresets', '--json'], 3000);
  if (!raw) return null;
  let parsed;
  try {
    parsed = JSON.parse(raw);
  } catch {
    return null;
  }
  const values = parsed?.value;
  if (!values || typeof values !== 'object' || Array.isArray(values)) return null;
  const presets = [];
  for (const [id, value] of Object.entries(values)) {
    if (!/^[A-Za-z][A-Za-z0-9_-]*$/.test(id)) continue;
    if (!value || typeof value !== 'object' || Array.isArray(value)) continue;
    if (!value.modelRoles || typeof value.modelRoles !== 'object' || Array.isArray(value.modelRoles)) continue;
    presets.push({
      id,
      modelRoles: value.modelRoles,
      defaultThinkingLevel: typeof value.defaultThinkingLevel === 'string' ? value.defaultThinkingLevel : 'auto'
    });
  }
  return presets.sort((a, b) => a.id.localeCompare(b.id));
}

function emit(value) {
  process.stdout.write(JSON.stringify(value) + '\n');
}

function main() {
  const [action = 'pane', paneId = '', cwdHint = ''] = process.argv.slice(2);

  if (action === 'pane' || action === 'active') {
    emit(describePane(paneId, cwdHint));
    return 0;
  }

  if (action === 'chunk') {
    const file = paneId;
    if (!file || !fs.existsSync(file)) {
      emit({ error: 'session file not found' });
      return 1;
    }
    const chunk = readChunk(file, cwdHint, process.argv[5]);
    if (!chunk) {
      emit({ error: 'session file unreadable' });
      return 1;
    }
    emit(chunk);
    return 0;
  }

  if (action === 'file-metrics') {
    const file = paneId;
    if (!file || !fs.existsSync(file)) {
      emit({ error: 'session file not found' });
      return 1;
    }
    const summary = readMetrics(file);
    if (!summary) {
      emit({ error: 'session file unreadable' });
      return 1;
    }
    emit(summary);
    return 0;
  }

  if (action === 'pane-client-pids') {
    emit(paneClientPids(paneId));
    return 0;
  }

  if (action === 'model-presets') {
    const presets = listModelPresets();
    if (!presets) {
      emit({ error: 'model presets unavailable' });
      return 1;
    }
    emit(presets);
    return 0;
  }

  if (action === 'tmux-panes') {
    emit(listTmuxPanes());
    return 0;
  }

  if (action === 'doctor') {
    emit({
      platform: PLATFORM,
      node: process.version,
      home: HOME,
      ompHome: ompHome(),
      ompHomeExists: fs.existsSync(ompHome()),
      tmux: tmuxAvailable(),
      liveClients: liveOmpClients().length
    });
    return 0;
  }

  emit({ error: `unknown action: ${action}` });
  return 1;
}

process.exitCode = main();

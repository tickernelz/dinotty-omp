{
  "id": "dinotty-omp",
  "name": "OMP Pilot",
  "version": "1.0.0",
  "minAppVersion": "0.19.0",
  "description": "Live session HUD, managed tmux launcher, session explorer and skill palette for the Oh My Pi coding agent",
  "description_zh": "Oh My Pi 编码代理的实时会话 HUD、托管 tmux 启动器、会话浏览器与技能面板",
  "category": "ai",
  "icon": "bot",
  "entry": "./dist/main.js",
  "styles": "./dist/styles.css",
  "showInToolbar": true,
  "permissions": [
    "workspace.read",
    "workspace.write",
    "native.execute"
  ],
  "commands": [
    {
      "id": "omp.quick-launch",
      "title": "OMP: launch a profile in a new tab"
    },
    {
      "id": "omp.split-launch",
      "title": "OMP: launch a profile in a split pane"
    },
    {
      "id": "omp.skill-palette",
      "title": "OMP: search skills and inject one"
    },
    {
      "id": "omp.open-session-viewer",
      "title": "OMP: open the session explorer"
    },
    {
      "id": "omp.tmux-copymode",
      "title": "OMP: toggle tmux copy-mode"
    }
  ],
  "bin": {
    "mode": "cli",
    "entry": "./bin/omp-bridge",
    "entries": {
      "windows-x86_64": "./bin/omp-bridge.cmd",
      "windows-aarch64": "./bin/omp-bridge.cmd"
    }
  },
  "requirements": {
    "cli": "omp"
  }
}
